---
import Base from '../layouts/Base.astro';
import { shelvedBooks, hasBookPage } from '../lib/content';

// Same source as the homepage and /reading/, so the three never disagree.
const reading = (await shelvedBooks()).get('reading') ?? [];
---

<Base
  title="Now — Tawanda Moyo"
  description="What Tawanda Moyo is working on, learning, and reading right now."
>
  <section>
    <h2>Now</h2>
    <div class="prose">
      <p><em>Last updated: July 2026</em></p>
      <p>
        It's winter in Southern Africa. The days are short, the nights long. I'm trying to get back into consistent jogging and writing. 
      </p>
      <h2>Working</h2>
      <ul>
        <li>
          Verifying the sources behind the
          <a href="https://africacomputetracker.org" target="_blank" rel="noopener">Africa Compute Tracker</a>.
          How it is built is written up on the
          <a href="/projects/african-datacentre-tracker/">project page</a>.
        </li>
        <li>
          <a href="/projects/zhira/">Zhira</a> - retrieval over my reading notes.
        </li>
      </ul>
      <h2>Learning</h2>
      <ul>
        <li>The <a href="https://www.cooperativeai.com/" target="_blank" rel="noopener">Cooperative AI</a> course.</li>
        <li>
          MITx <a href="https://mitxonline.mit.edu/" target="_blank" rel="noopener">Data, Economics, and
          Development Policy</a> - currently Good Economics for Hard Times.
        </li>
      </ul>
      <h2>Reading</h2>
      <ul>
        {reading.map((book) => (
          <li>
            <em>{hasBookPage(book) ? <a href={`/reading/${book.id}/`}>{book.data.title}</a> : book.data.title}</em>
            {book.data.author && ` - ${book.data.author}`}.
          </li>
        ))}
      </ul>
      <p><a href="/reading/">The whole shelf →</a></p>
    </div>
  </section>
</Base>
