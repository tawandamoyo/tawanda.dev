---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { everyPost, postSlug, postMetaDescription, postKind, resolveRelated, booksLinkingTo, mergeLinks } from '../lib/content';
import { author, breadcrumbs, SITE, WEBSITE_ID } from '../lib/schema';

export async function getStaticPaths() {
  const posts = await everyPost();
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const description = postMetaDescription(post);
const related = mergeLinks(await resolveRelated(post.data.related ?? []), await booksLinkingTo(`post:${post.id}`));

const dateLong = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readMins = Math.max(1, Math.round(wordCount / 200));
const kind = postKind(post);
const kindLabel = kind.charAt(0).toUpperCase() + kind.slice(1);
const isEssayLayout = kind === 'essay';

const slug = postSlug(post);
const url = `${SITE}/${slug}/`;
const ogImage = `/og/posts/${slug}.png`;
const keywords = [...new Set([...post.data.categories, ...post.data.tags])];
const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description,
    url,
    mainEntityOfPage: url,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    author,
    publisher: author,
    isPartOf: { '@id': WEBSITE_ID },
    image: { '@type': 'ImageObject', url: `${SITE}${ogImage}`, width: 1200, height: 630 },
    wordCount,
    inLanguage: 'en',
    articleSection: kindLabel,
    ...(keywords.length > 0 && { keywords: keywords.join(', ') }),
  },
  breadcrumbs([['Home', '/'], ['Writing', '/writing/'], [post.data.title, `/${slug}/`]]),
];

// Nest H3s under their preceding H2 so the TOC reads section / subsection,
// the way brandur.org's does — deeper headings than that would crowd an 11rem rail.
type TocItem = { slug: string; text: string; children: { slug: string; text: string }[] };
const tocItems: TocItem[] = [];
for (const h of headings) {
  if (h.depth === 2) tocItems.push({ slug: h.slug, text: h.text, children: [] });
  else if (h.depth === 3 && tocItems.length > 0) {
    tocItems[tocItems.length - 1].children.push({ slug: h.slug, text: h.text });
  }
}
---

<Base
  title={`${post.data.title} — Tawanda Moyo`}
  description={description}
  ogType="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.updated}
  tags={keywords}
  ogImage={ogImage}
  schema={schema}
  wide={isEssayLayout}
>
  {isEssayLayout && <div class="readprogress" aria-hidden="true"></div>}
  <article class:list={['post', { 'post-long': isEssayLayout }]}>
    {isEssayLayout ? (
      <Fragment>
        <h1 class="posttitle">{post.data.title}</h1>
        <div class="postgrid">
          <aside class="postmeta-rail">
            <p class="metalabel mono">{kindLabel}</p>
            <div class="metagrid">
              <div>
                <p class="metaklabel mono">Published</p>
                <p class="metadate">{dateLong}</p>
              </div>
              <div>
                <p class="metaklabel mono">Location</p>
                <p class="metaloc">Harare</p>
              </div>
            </div>
            <p class="metaread mono">
              {readMins} min{post.data.revisions ? ` · revised ${post.data.revisions} times` : ''}
            </p>
            {post.data.aside && <p class="metaaside">{post.data.aside}</p>}
          </aside>

          <div class="body prose">
            <Content />
          </div>

          {tocItems.length > 0 && (
            <nav class="toc" aria-label="Table of contents">
              <p class="toclabel mono">Contents</p>
              <ol>
                {tocItems.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                    {h.children.length > 0 && (
                      <ol>
                        {h.children.map((c) => (
                          <li><a href={`#${c.slug}`}>{c.text}</a></li>
                        ))}
                      </ol>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </div>
      </Fragment>
    ) : (
      <Fragment>
        <header>
          <h1>{post.data.title}</h1>
          <p class="postmeta mono">
            {kindLabel} · {dateLong}
            {post.data.tags.length > 0 && ` · ${post.data.tags.slice(0, 2).join(' · ')}`}
          </p>
        </header>
        <div class="body prose">
          <Content />
        </div>
      </Fragment>
    )}
    <footer class="postend">
      <p>
        Have any thoughts, feedback, or objections? <a href="mailto:moyotawanda@gmail.com">Email me</a>; I read
        and reply to every one.
      </p>
      {related.length > 0 && (
        <p class="refs">
          <span aria-hidden="true">↔</span> {related.map((r, i) => (
            <Fragment>{i > 0 && ' · '}<a href={r.href}>{r.title}</a></Fragment>
          ))}
        </p>
      )}
      <p class="refs">
        <a href="/writing/">More writing</a> · <a href="/feed.xml">Subscribe by RSS</a>
      </p>
    </footer>
  </article>
</Base>

<script>
  // Long essays only: mark the section being read in the contents rail, and
  // draw how far through the piece the reader is. One rAF-throttled scroll
  // handler; layout is read once per frame at most.
  const bar = document.querySelector<HTMLElement>('.readprogress');
  const body = document.querySelector<HTMLElement>('.post-long .body');
  if (bar && body) {
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]').forEach((a) => {
      links.set(decodeURIComponent(a.hash.slice(1)), a);
    });
    const heads = [...body.querySelectorAll<HTMLElement>('h2[id], h3[id]')].filter((h) => links.has(h.id));
    let current: HTMLAnchorElement | undefined;
    let queued = false;

    const update = () => {
      queued = false;
      const rect = body.getBoundingClientRect();
      const span = rect.height - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 1;
      bar.style.transform = `scaleX(${p})`;

      let active: HTMLAnchorElement | undefined;
      for (const h of heads) {
        if (h.getBoundingClientRect().top > window.innerHeight * 0.3) break;
        active = links.get(h.id);
      }
      if (active !== current) {
        current?.removeAttribute('aria-current');
        active?.setAttribute('aria-current', 'location');
        current = active;
      }
    };
    const queue = () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue, { passive: true });
    update();
  }
</script>
