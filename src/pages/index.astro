---
import Base from '../layouts/Base.astro';
import { allPosts, homeEssays, postSlug, postKind, fmtDate, postDescription, shelvedBooks, hasBookPage, readingStats, num } from '../lib/content';

const essays = await homeEssays();
// Genuinely the newest thing published, not the newest of the featured five —
// otherwise the homepage keeps announcing a stale post as "latest".
const latest = (await allPosts())[0];
// What is open on the desk now; if nothing is, the books kept close.
const shelves = await shelvedBooks();
const desk = (shelves.get('reading')?.length ? shelves.get('reading')! : shelves.get('reference') ?? []).slice(0, 4);
---

<Base
  description="Software engineer and writer in Harare building public tools and research on AI compute, evaluations, forecasting, and human agency."
  includePersonSchema
>
  <div class="intro">
    <p>
      I am a software engineer and writer. I build tools and infrastructure for understanding AI systems.
    </p>
    <p>
      I am currently most interested in making sense of widespread machine intelligence - evaluations, forecasting, verification - and the slower question of how to preserve human agency as machines get more capable and are deployed at scale.
    </p>
  </div>

  {latest && (
    <p class="latest">
      <span class="mono">latest {postKind(latest)}</span>
      <span><a href={`/${postSlug(latest)}/`}>{latest.data.title}</a> - {fmtDate(latest.data.date)}</span>
    </p>
  )}

  <section id="work">
    <h2>Work</h2>

    <div class="entry entry-media" id="w-tracker">
      <a class="thumb" href="https://africacomputetracker.org" tabindex="-1" aria-hidden="true">
        <img src="/thumb-tracker.webp" alt="" width="400" height="210" loading="lazy" decoding="async" />
      </a>
      <div class="entry-body">
        <div class="head">
          <span class="title"><a href="https://africacomputetracker.org">Africa Compute Tracker</a></span>
          <span class="live">live</span>
        </div>
        <p class="what">
          An open, version-controlled dataset of AI compute infrastructure across
          Africa. Tracking facilities in 5 countries, with every data point sourced, dated,
          and assigned a confidence level.
        </p>
        <p class="aside">What counts as AI compute? What are the consequences of datacentres? What does it mean for the countries that host them? </p>
        <p class="refs"><span aria-hidden="true">↔</span> <a href="/projects/african-datacentre-tracker/">how it is built</a></p>
      </div>
    </div>

    <div class="entry" id="w-spidermonkey">
      <div class="head">
        <span class="title"><a href="/projects/spidermonkey-tc39-joint-iteration/">SpiderMonkey — TC39 Joint Iteration</a></span>
        <span class="when mono">Firefox 133</span>
      </div>
      <p class="what">
        Patches landed in Firefox’s JavaScript engine through Outreachy -
        the nightly-gated preference controlling the TC39 Joint Iteration
        proposal, and the placeholder implementation for <code>Iterator.zip</code>.
      </p>
      <p class="refs"><span aria-hidden="true">↔</span> <a href="/projects/open-source/">other standards &amp; open-source work</a></p>
    </div>

    <div class="entry" id="w-reading">
      <div class="head">
        <span class="title"><a href="/projects/#reading">Reading infrastructure</a></span>
        <span class="when mono">{readingStats.firstYear}–</span>
      </div>
      <p class="what">
        Reading since {readingStats.firstYear}: {num(readingStats.highlights)} highlights from {readingStats.books} books.
        <a href="/projects/kindle-highlights-desktop-app/">Nota</a> extracts them,
        the <a href="/projects/kindle-highlights-cli-tool/">CLI</a> makes that
        scriptable, and <a href="/projects/zhira/">Zhira</a> searches them.
      </p>
    </div>

    <p class="allwriting"><a href="/projects/">All projects →</a></p>
  </section>

  <section id="essays">
    <h2>Essays</h2>

    {essays.map((post) => (
      <div class="entry">
        <div class="head">
          <span class="title"><a href={`/${postSlug(post)}/`}>{post.data.title}</a></span>
          <span class="when mono">{fmtDate(post.data.date)}</span>
        </div>
        {postDescription(post) && <p class="what">{postDescription(post)}</p>}
      </div>
    ))}

    <p class="allwriting"><a href="/writing/">All writing →</a></p>
  </section>

  <section id="now">
    <h2>Now</h2>
    <div class="prose">
      <p>
        Tracking AI Compute in Africa, thinking about autonomy and truth in the AI age, and learning more about the mechanics of cooperation. 
        <a href="/now/">More on the now page →</a>
      </p>
    </div>
  </section>

  <section id="reading">
    <h2>Reading</h2>
    <ul class="reading">
      {desk.map((book) => (
        <li>
          <em>{hasBookPage(book) ? <a href={`/reading/${book.id}/`}>{book.data.title}</a> : book.data.title}</em>
          {book.data.author && <span class="by"> — {book.data.author}</span>}
        </li>
      ))}
    </ul>
    <p class="allwriting"><a href="/reading/">Everything I have read →</a></p>
  </section></Base>
