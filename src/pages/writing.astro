---
import Base from '../layouts/Base.astro';
import { allPosts, archivedPosts, postSlug, fmtDate, isEssay, postDescription } from '../lib/content';

const posts = await allPosts();
const essays = posts.filter(isEssay);
const notes = posts.filter((p) => !isEssay(p));
const archive = await archivedPosts();
---

<Base
  title="Writing — Tawanda Moyo"
  description="Essays on AI, technology, and human agency; notes on books, philosophy, and building things."
>
  <section id="essays">
    <h2>Essays</h2>
    <p class="shelfnote">Longer, a little more thoughtful</p>

    {essays.map((post) => (
      <div class="entry">
        <div class="head">
          <span class="title"><a href={`/${postSlug(post)}/`}>{post.data.title}</a></span>
          <span class="when mono">{fmtDate(post.data.date)}</span>
        </div>
        {postDescription(post) && <p class="what">{postDescription(post)}</p>}
      </div>
    ))}
  </section>

  <section id="notes">
    <h2>Notes</h2>
    <p class="shelfnote">Books, philosophy, projects, fragments - thinking in public, less polished.</p>

    {notes.map((post) => (
      <div class="entry">
        <div class="head">
          <span class="title"><a href={`/${postSlug(post)}/`}>{post.data.title}</a></span>
          <span class="when mono">
            {post.data.categories[0] ? `${post.data.categories[0].toLowerCase()} · ` : ''}{fmtDate(post.data.date)}
          </span>
        </div>
        {postDescription(post) && <p class="what">{postDescription(post)}</p>}
      </div>
    ))}
  </section>

  <section id="elsewhere">
    <h2>Published elsewhere</h2>
    <p class="shelfnote">Published outside this site.</p>

    <div class="entry">
      <div class="head">
        <span class="title">
          <a href="https://www.techzim.co.zw/2025/05/claude-4-pushes-boundaries-triggers-new-ai-safety-level/">
            Claude Opus 4 Pushes Boundaries — And Triggers a New AI Safety Level
          </a>
        </span>
        <span class="when mono">techzim · May 2025</span>
      </div>
      <p class="what">
        Anthropic ships a model under ASL-3 for the first time, and what a
        capability threshold looks like when a lab actually crosses one.
      </p>
    </div>

    <div class="entry">
      <div class="head">
        <span class="title">
          <a href="https://www.techzim.co.zw/2025/05/groks-warning-why-africa-must-shape-its-ai-future/">
            Grok’s Warning: Why Africa Must Shape Its AI Future
          </a>
        </span>
        <span class="when mono">techzim · May 2025</span>
      </div>
      <p class="what">
        A chatbot starts talking about white genocide in South Africa unprompted —
        the case for African involvement in how these systems get governed.
      </p>
    </div>

    <p class="allwriting">
      <a href="https://www.techzim.co.zw/author/tawandamoyo-2/">Everything I have written for Techzim →</a>
    </p>

    <div class="entry">
      <div class="head">
        <span class="title"><a href="https://talkjs.com/resources/author/tawanda/">Developer tutorials — TalkJS</a></span>
        <span class="when mono">talkjs · 2022</span>
      </div>
      <p class="what">
        Implementation guides for a chat SDK, written as a technical writer —
        webhooks, contact lists, support chat, live comments.
      </p>
    </div>
  </section>

  {archive.length > 0 && (
    <section id="archive">
      <h2>Archive</h2>
      <p class="shelfnote">Early dev logs and how-tos, kept for the record.</p>
      <ul class="archivelist">
        {archive.map((post) => (
          <li>
            <a href={`/${postSlug(post)}/`}>{post.data.title}</a>
            <span class="when mono">{fmtDate(post.data.date)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
