---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allProjects, projectSlug, fmtDate, PROJECT_AREAS, resolveRelated, booksLinkingTo, mergeLinks } from '../../lib/content';
import { author, breadcrumbs, SITE, WEBSITE_ID } from '../../lib/schema';

export async function getStaticPaths() {
  const projects = await allProjects();
  return projects.map((project) => ({
    params: { slug: projectSlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const area = PROJECT_AREAS.find((a) => a.key === project.data.area);
const related = mergeLinks(await resolveRelated(project.data.related ?? []), await booksLinkingTo(`project:${project.id}`));

const slug = projectSlug(project);
const url = `${SITE}/projects/${slug}/`;
const ogImage = `/og/projects/${slug}.png`;
const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${url}#work`,
    name: project.data.title,
    description: project.data.summary,
    url,
    dateCreated: project.data.date.toISOString(),
    creator: author,
    isPartOf: { '@id': WEBSITE_ID },
    image: `${SITE}${ogImage}`,
    ...(project.data.tags.length > 0 && { keywords: project.data.tags.join(', ') }),
    ...(project.data.link && { sameAs: project.data.link }),
  },
  breadcrumbs([['Home', '/'], ['Work', '/projects/'], [project.data.title, `/projects/${slug}/`]]),
];
---

<Base
  title={`${project.data.title} — Tawanda Moyo`}
  description={project.data.summary}
  ogType="article"
  publishedTime={project.data.date}
  tags={project.data.tags}
  ogImage={ogImage}
  schema={schema}
>
  <article class="post">
    <header>
      <p class="crumb mono"><a href="/projects/">projects</a> / {area?.label.toLowerCase()}</p>
      <h1>{project.data.title}</h1>
      <p class="postmeta mono">
        {project.data.status === 'live' ? (
          <span class="live">live</span>
        ) : project.data.status === 'ongoing' || project.data.status === 'coming' ? (
          project.data.status
        ) : (
          fmtDate(project.data.date)
        )}
        {project.data.tags.length > 0 && ` · ${project.data.tags.join(' · ')}`}
      </p>
      <p class="lede">{project.data.summary}</p>
      {project.data.link && (
        <p class="visit">
          ↗ <a href={project.data.link}>{new URL(project.data.link).hostname}</a>
        </p>
      )}
    </header>
    <div class="body prose">
      <Content />
    </div>
    <footer class="postend">
      {related.length > 0 && (
        <p class="refs">
          <span aria-hidden="true">↔</span> {related.map((r, i) => (
            <Fragment>{i > 0 && ' · '}<a href={r.href}>{r.title}</a></Fragment>
          ))}
        </p>
      )}
      <p class="refs">
        <a href="/projects/">All projects</a> · <a href="/#work">Current work</a>
      </p>
    </footer>
  </article>
</Base>
