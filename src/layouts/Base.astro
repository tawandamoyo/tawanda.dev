---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'article' for essays and project pages, 'website' otherwise. */
  ogType?: 'website' | 'article';
  /** Publication date for article social metadata. */
  publishedTime?: Date;
  /** Wider grid for long-form posts with a metadata rail and table of contents. */
  wide?: boolean;
  /** Person schema belongs once per crawl path, not on every page — set on / and /about/. */
  includePersonSchema?: boolean;
}

const {
  title = 'Tawanda Moyo',
  description = 'Software engineer and technical writer in Harare writing about AI, technology, and human agency.',
  ogType = 'website',
  publishedTime,
  wide = false,
  includePersonSchema = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        // Approximate sunrise/sunset in Harare by month (local time, UTC+2).
        var SUN = [
          [5.6, 18.8], [5.9, 18.7], [6.05, 18.3], [6.15, 17.8], [6.35, 17.45], [6.5, 17.35],
          [6.55, 17.5], [6.3, 17.7], [5.9, 17.85], [5.45, 18.05], [5.25, 18.35], [5.3, 18.65]
        ];
        var root = document.documentElement;
        var note = null;
        var toggle = null;
        var MODES = ['sun', 'day', 'night'];
        var LABELS = { sun: 'following the sun', day: 'always daylight', night: 'always night' };
        var mode = localStorage.getItem('sun-mode') || 'sun';
        if (MODES.indexOf(mode) === -1) mode = 'sun';

        function harareNow() {
          var parts = new Intl.DateTimeFormat('en-GB', {
            timeZone: 'Africa/Harare', hour: 'numeric', minute: 'numeric', month: 'numeric', hour12: false
          }).formatToParts(new Date());
          var get = function (t) {
            for (var i = 0; i < parts.length; i++) if (parts[i].type === t) return parseInt(parts[i].value, 10);
            return 0;
          };
          return { month: get('month'), hour: get('hour') + get('minute') / 60 };
        }

        // Palettes mirror the data-phase tokens in global.css.
        var PAL = {
          night: { ground: '#0F130F', ink: '#D6D8CC', muted: '#8B9084', faint: '#62675C', accent: '#8CC29B', hair: [214, 216, 204, 0.16] },
          dawn:  { ground: '#F8F4EC', ink: '#262420', muted: '#77716A', faint: '#A39C92', accent: '#396B45', hair: [38, 36, 32, 0.14] },
          day:   { ground: '#F7F8F3', ink: '#20241E', muted: '#6E7268', faint: '#9A9E93', accent: '#2F6B45', hair: [32, 36, 30, 0.14] },
          dusk:  { ground: '#F3EFE6', ink: '#27231E', muted: '#786F63', faint: '#A59A8B', accent: '#38663F', hair: [39, 35, 30, 0.15] }
        };
        var KEYS = ['ground', 'ink', 'muted', 'faint', 'accent'];

        // The day is a timeline of palette anchors; between anchors the
        // tokens interpolate, so the page warms and cools continuously.
        function anchorsFor(month) {
          var s = SUN[month - 1], rise = s[0], set = s[1];
          return [
            [rise - 0.7, 'night'], [rise, 'dawn'], [rise + 1.2, 'day'],
            [set - 2.5, 'day'], [set - 0.2, 'dusk'], [set + 0.7, 'night']
          ];
        }

        function blendAt(t) {
          var A = anchorsFor(t.month), h = t.hour;
          if (h < A[0][0] || h >= A[A.length - 1][0]) return { a: 'night', b: 'night', f: 0 };
          for (var i = 0; i < A.length - 1; i++) {
            if (h >= A[i][0] && h < A[i + 1][0]) {
              return { a: A[i][1], b: A[i + 1][1], f: (h - A[i][0]) / (A[i + 1][0] - A[i][0]) };
            }
          }
          return { a: 'night', b: 'night', f: 0 };
        }

        function rgb(hex) {
          return [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)];
        }
        function mixCh(a, b, f) { return Math.round(a + (b - a) * f); }
        function mixHex(h1, h2, f) {
          var a = rgb(h1), b = rgb(h2);
          return 'rgb(' + mixCh(a[0], b[0], f) + ',' + mixCh(a[1], b[1], f) + ',' + mixCh(a[2], b[2], f) + ')';
        }

        function setBlend(bl) {
          var pa = PAL[bl.a], pb = PAL[bl.b];
          for (var i = 0; i < KEYS.length; i++) {
            root.style.setProperty('--' + KEYS[i], mixHex(pa[KEYS[i]], pb[KEYS[i]], bl.f));
          }
          var ha = pa.hair, hb = pb.hair;
          root.style.setProperty('--hairline', 'rgba(' + mixCh(ha[0], hb[0], bl.f) + ',' + mixCh(ha[1], hb[1], bl.f) + ',' +
            mixCh(ha[2], hb[2], bl.f) + ',' + (ha[3] + (hb[3] - ha[3]) * bl.f).toFixed(3) + ')');
        }
        function clearBlend() {
          for (var i = 0; i < KEYS.length; i++) root.style.removeProperty('--' + KEYS[i]);
          root.style.removeProperty('--hairline');
        }

        function sunNote(t, phase) {
          var s = SUN[t.month - 1], rise = s[0], set = s[1], h = t.hour;
          function hrs(x) { var r = Math.round(x); return r <= 1 ? 'about an hour' : 'about ' + r + ' hours'; }
          if (phase === 'dawn') return 'first light is breaking over southern Africa now.';
          if (phase === 'dusk') return 'the sun is setting over southern Africa now.';
          if (phase === 'day') {
            var left = set - h;
            if (left < 1.5) return 'it is late afternoon in southern Africa — sunset soon.';
            return 'it is daylight in southern Africa — sunset in ' + hrs(left) + '.';
          }
          var until = h < rise ? rise - h : 24 - h + rise;
          if (until < 1.5) return 'it is night in southern Africa — first light soon.';
          return 'it is night in southern Africa — sunrise in ' + hrs(until) + '.';
        }

        function syncThemeColor() {
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', getComputedStyle(root).getPropertyValue('--ground').trim());
        }

        function apply() {
          if (mode === 'sun') {
            var t = harareNow();
            var bl = blendAt(t);
            var phase = bl.f < 0.5 ? bl.a : bl.b;
            setBlend(bl);
            root.setAttribute('data-phase', phase);
            if (note) note.textContent = 'This page keeps Central Africa Time — ' + sunNote(t, phase);
          } else {
            clearBlend();
            root.setAttribute('data-phase', mode);
            if (note) note.textContent = 'This page keeps Central Africa Time.';
          }
          if (toggle) toggle.textContent = LABELS[mode];
          syncThemeColor();
        }

        // Set colors immediately, before the body paints, so there is no
        // flash of the default light palette on load or navigation.
        apply();

        document.addEventListener('DOMContentLoaded', function () {
          note = document.getElementById('sun-note');
          toggle = document.getElementById('sun-toggle');
          toggle.addEventListener('click', function () {
            mode = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
            localStorage.setItem('sun-mode', mode);
            apply();
          });
          apply();
          setInterval(apply, 60 * 1000);
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Tawanda Moyo" href="/feed.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tawanda Moyo" />
    <meta property="og:locale" content="en_ZW" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Tawanda Moyo" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Tawanda Moyo" />
    <meta name="twitter:site" content="@tbmoyo" />
    <meta name="theme-color" content="#F7F8F3" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {includePersonSchema && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Tawanda Moyo',
        url: 'https://tawanda.dev/',
        jobTitle: 'Software Engineer & Technical Writer',
        alumniOf: 'Harare Institute of Technology',
        description:
          'Software engineer and technical writer working on AI safety — compute governance, evaluations, and forecasting.',
        address: { '@type': 'PostalAddress', addressLocality: 'Harare', addressCountry: 'ZW' },
        sameAs: ['https://github.com/tawandamoyo', 'https://twitter.com/tbmoyo'],
      })} />
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={['page', { 'page-wide': wide }]}>
      <header class="site">
        <h1><a href="/">Tawanda Moyo</a></h1>
        <p class="role">engineer &amp; writer — AI safety, compute governance</p>
        <nav>
          <a href="/about/" aria-current={current('/about')}>Who I am</a>
          <a href="/projects/" aria-current={current('/projects')}>Work</a>
          <a href="/writing/" aria-current={current('/writing')}>Writing</a>
          <a href="/now/" aria-current={current('/now')}>Now</a>
          <a href="/#reading">Reading</a>
          <a href="mailto:moyotawanda@gmail.com">Email</a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site">
        <p class="contact">
          <a href="mailto:moyotawanda@gmail.com">Email</a>
          <a href="https://github.com/tawandamoyo" rel="me">GitHub</a>
          <a href="https://twitter.com/tbmoyo" rel="me">Twitter</a>
          <a href="/feed.xml">RSS</a>
        </p>
        <div class="sunline">
          <span class="mono" id="sun-note">This page keeps Central Africa Time.</span>
          <button type="button" id="sun-toggle" aria-label="Change how the page chooses light or dark">following the sun</button>
        </div>
        <p class="heart">Moyo means heart.</p>
      </footer>
    </div>
  </body>
</html>
